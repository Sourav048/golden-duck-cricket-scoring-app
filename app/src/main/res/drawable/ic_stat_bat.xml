<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!--
        The Secret Sauce: Draw it perfectly vertical, perfectly centered (24,24),
        and let the rendering engine rotate it. Zero chopped edges. Flawless symmetry.
    -->
    <group
        android:pivotX="24"
        android:pivotY="24"
        android:rotation="45">

        <!-- 1. BLADE BASE (Warm Willow Wood) -->
        <path
            android:fillColor="#E4BA7F"
            android:pathData="M 22,18 L 26,18 C 28,18 30,19 30,22 L 30,42 C 30,44 28,45 24,45 C 20,45 18,44 18,42 L 18,22 C 18,19 20,18 22,18 Z" />

        <!-- 2. V-SPLICE (Where the cane handle meets the wood) -->
        <path
            android:fillColor="#F0D5AA"
            android:pathData="M 22,18 L 26,18 L 24,24 Z" />

        <!-- 3. DECALS / STICKERS -->
        <!-- Top Navy Blue Chevron -->
        <path
            android:fillColor="#1D3557"
            android:pathData="M 18,25 L 24,28 L 30,25 L 30,27 L 24,30 L 18,27 Z" />
        <!-- Bottom Sporty Red Chevron -->
        <path
            android:fillColor="#E63946"
            android:pathData="M 18,28 L 24,31 L 30,28 L 30,31 L 24,34 L 18,31 Z" />
        <!-- Lower Toe Stripe -->
        <path
            android:fillColor="#1D3557"
            android:pathData="M 18,36 L 30,36 L 30,37.5 L 18,37.5 Z" />

        <!-- 4. BLADE 3D SHADOW (Creates the iconic bat spine) -->
        <!-- A transparent black overlay perfectly masked to the right half of the blade -->
        <path
            android:fillColor="#1A000000"
            android:pathData="M 24,18 L 26,18 C 28,18 30,19 30,22 L 30,42 C 30,44 28,45 24,45 Z" />

        <!-- 5. HANDLE TWINE / BINDING -->
        <path
            android:fillColor="#E8E8E8"
            android:pathData="M 22,17 L 26,17 L 26,18 L 22,18 Z" />
        <!-- Twine 3D Shadow -->
        <path
            android:fillColor="#33000000"
            android:pathData="M 24,17 L 26,17 L 26,18 L 24,18 Z" />

        <!-- 6. HANDLE GRIP -->
        <path
            android:fillColor="#1D3557"
            android:pathData="M 22,6 L 26,6 L 26,17 L 22,17 Z" />
        <!-- Grip Texture / Ridges -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M 22,8 L 26,8 L 26,9 L 22,9 Z M 22,11 L 26,11 L 26,12 L 22,12 Z M 22,14 L 26,14 L 26,15 L 22,15 Z" />
        <!-- Grip 3D Shadow -->
        <path
            android:fillColor="#4D000000"
            android:pathData="M 24,6 L 26,6 L 26,17 L 24,17 Z" />

        <!-- 7. HANDLE POMMEL / KNOB (Rounded Top) -->
        <path
            android:fillColor="#112233"
            android:pathData="M 21,6 L 27,6 L 27,5 C 27,3 25.5,2 24,2 C 22.5,2 21,3 21,5 Z" />
        <!-- Knob 3D Shadow -->
        <path
            android:fillColor="#4D000000"
            android:pathData="M 24,2 C 25.5,2 27,3 27,5 L 27,6 L 24,6 Z" />

    </group>
</vector>