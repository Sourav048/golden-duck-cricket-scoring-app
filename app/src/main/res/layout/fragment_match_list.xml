<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerMatchList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include layout="@layout/item_match_list_shimmer" />
            <include layout="@layout/item_match_list_shimmer" />
            <include layout="@layout/item_match_list_shimmer" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatchList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutEmptyMatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_menu_today"
            android:alpha="0.2"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No matches found here."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Fast Scroller Track -->
    <View
        android:id="@+id/viewFastScrollTrack"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="6dp"
        android:layout_marginVertical="16dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1"
        android:visibility="gone" />

    <!-- Fast Scroller Handle Pill -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFastScrollHandle"
        android:layout_width="14dp"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="7dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorPrimary" />

    <!-- Touch Container for Fast Scroll -->
    <View
        android:id="@+id/viewFastScrollTouchArea"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:visibility="gone" />

    <!-- Fast Scroll Date Bubble -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFastScrollBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="?attr/colorPrimary">

        <TextView
            android:id="@+id/tvFastScrollBubbleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="TODAY(3)"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>