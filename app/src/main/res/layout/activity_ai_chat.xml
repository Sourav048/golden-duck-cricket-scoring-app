<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAiChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnAiBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Back" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ai_assistant"
                android:contentDescription="AI Avatar" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duckie AI Assistant 🤖"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvAiSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="League: Local • Ask anything!"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ibAiClearChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="?attr/colorError"
            android:contentDescription="Clear Chat History" />

        <ImageButton
            android:id="@+id/ibAiSpeaker"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Toggle Voice Output" />
    </LinearLayout>

    <!-- Options Bar with Dropdowns -->
    <LinearLayout
        android:id="@+id/layoutAiOptionsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical">

        <!-- Left Dropdown: Response Language -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAiLanguage"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            android:hint="Response Language">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvAiLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:dropDownHeight="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Right Dropdown: Active Player Identity -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAiSecondary"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            android:visibility="visible"
            android:hint="Who are you?">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvAiSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:dropDownHeight="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAiChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/layoutAiTyping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duckie is thinking... 🤖💭"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Bottom Chat Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="8dp">

        <EditText
            android:id="@+id/etAiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input_rounded"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:hint="Ask Duckie anything..."
            android:maxLines="4"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/ibAiMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Voice Input" />

        <ImageButton
            android:id="@+id/btnAiSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Send Message" />
    </LinearLayout>

</LinearLayout>
