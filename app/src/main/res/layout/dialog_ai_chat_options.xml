<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message Actions"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/optionAiCopy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp"
        app:drawableStartCompat="@drawable/ic_copy"
        android:drawablePadding="14dp"
        app:drawableTint="?attr/colorOnSurface"
        android:text="Copy Text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionAiSpeak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp"
        app:drawableStartCompat="@drawable/ic_volume_up"
        android:drawablePadding="14dp"
        app:drawableTint="?attr/colorOnSurface"
        android:text="Speak Aloud"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionAiShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp"
        app:drawableStartCompat="@drawable/ic_export_records"
        android:drawablePadding="14dp"
        app:drawableTint="?attr/colorOnSurface"
        android:text="Share Text"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionAiDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp"
        app:drawableStartCompat="@drawable/ic_delete"
        android:drawablePadding="14dp"
        app:drawableTint="#EF4444"
        android:text="Delete Message"
        android:textColor="#EF4444"
        android:textSize="15sp" />

</LinearLayout>