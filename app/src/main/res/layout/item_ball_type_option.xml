<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBallType"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="1.5dp"
    app:strokeColor="?attr/colorOutline"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Ball Color Circle Badge -->
        <FrameLayout
            android:id="@+id/badgeBallTypeContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/ivBallBadgeBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="custom_color"
                android:contentDescription="Ball Type Badge Background"
                android:src="@drawable/circle_bg_orange" />

            <ImageView
                android:id="@+id/ivBallIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:tag="custom_color"
                android:contentDescription="Ball Type Icon"
                android:src="@drawable/ic_ball_type"
                app:tint="@color/white" />

        </FrameLayout>

        <!-- Title and Description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBallTypeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvBallTypeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Selected Checkmark -->
        <ImageView
            android:id="@+id/ivBallSelected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Selected Ball Type Checkmark"
            android:src="@drawable/ic_check_circle"
            app:tint="?attr/colorPrimary"
            android:visibility="gone"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
