<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStatRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp">

        <!-- Rank Badge -->
        <FrameLayout
            android:id="@+id/flRankBadge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:tag="custom_color"
            android:background="@drawable/bg_rank_pill">

            <TextView
                android:id="@+id/tvStatRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:text="4"
                android:textSize="14sp"
                android:textStyle="bold"
                android:tag="custom_color"
                android:textColor="?attr/colorOnSurface" />
        </FrameLayout>

        <!-- Player Photo Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStatPhoto"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_placeholder"
            app:strokeWidth="1.5dp"
            app:strokeColor="#2E3A4E"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- Player Name and Subtitle Context -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatPlayerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Harsh Singh"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvStatSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Rank #4"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Stat Value Pill Badge with Formatted Number & Unit -->
        <LinearLayout
            android:id="@+id/flStatValueBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="custom_color"
            android:background="@drawable/bg_stat_value_pill"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvStatValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="custom_color"
                tools:text="282"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvStatUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:tag="custom_color"
                tools:text="RUNS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>