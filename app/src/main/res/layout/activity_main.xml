<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScoringHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardPreventCornerOverlap="false"
            android:clipToOutline="true"
            android:tag="custom_color">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:background="@drawable/bg_scoring_header"
                android:tag="custom_color">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutLiveHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="custom_color">

                    <LinearLayout
                        android:id="@+id/layoutTeamRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvCurrentTeamName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TEAM NAME"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_subtitle"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutLeftScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutTeamRow"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/scoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0"
                            android:textSize="50sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_text"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/oversText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(0.0/0)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_subtitle"
                            android:layout_marginTop="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutMiddleRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        app:layout_constraintStart_toEndOf="@id/layoutLeftScore"
                        app:layout_constraintEnd_toStartOf="@+id/cardProjected"
                        app:layout_constraintTop_toTopOf="@id/layoutLeftScore"
                        app:layout_constraintBottom_toBottomOf="@id/layoutLeftScore">

                        <TextView
                            android:id="@+id/tvRateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_text" />

                        <TextView
                            android:id="@+id/tvRateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CRR"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_subtitle"
                            android:letterSpacing="0.06"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutLiveCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_scoring_header_pill"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/circle_bg_red" />

                        <TextView
                            android:id="@+id/tvLiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live: 1"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_text" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProjected"
                        android:layout_width="145dp"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/scoring_header_pill_bg"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/scoring_header_pill_stroke"
                        android:tag="custom_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutLiveCount"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/tvAnalysisLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="8dp"
                            android:text="Projected: 0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/scoring_header_pill_text"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView android:id="@+id/tvAnalysisType" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvFinalResultBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="MATCH OVER"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/scoring_header_text"
                    android:tag="custom_color"
                    android:visibility="gone"
                    android:paddingVertical="16dp" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutScoring"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:tabMode="scrollable"
            app:tabGravity="center"
            app:tabMinWidth="0dp"
            app:tabPaddingStart="14dp"
            app:tabPaddingEnd="14dp"
            app:tabSelectedTextColor="@color/tab_selected_text"
            app:tabTextColor="@color/tab_unselected_text"
            app:tabIndicatorColor="@color/tab_selected_text"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorAnimationMode="elastic"
            app:tabTextAppearance="@style/CustomTabTextAppearance"
            android:background="@color/tab_bg"
            android:tag="custom_color" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerScoring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="@drawable/status_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
