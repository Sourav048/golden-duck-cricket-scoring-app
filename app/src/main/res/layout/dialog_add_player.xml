<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Unified Quick Add Section -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/quickAddContainer"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search Player(Name or #)"
        android:layout_marginBottom="16dp"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">
        <AutoCompleteTextView
            android:id="@+id/quickAddInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:completionThreshold="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:id="@+id/quickAddDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:alpha="0.2"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDialogPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorSurfaceVariant"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
            android:layout_marginEnd="12dp" />

        <EditText
            android:id="@+id/playerNameInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/player_name_hint"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />
    </LinearLayout>

    <EditText
        android:id="@+id/playerJerseyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Jersey Number"
        android:inputType="number"
        android:maxLength="3"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_photo_label"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_camera"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnPickGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_gallery"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
