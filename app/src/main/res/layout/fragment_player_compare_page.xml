<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <!-- GUIDANCE MESSAGE: Top-level constraint ensure it never hides -->
    <TextView
        android:id="@+id/tvCompareGuidance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tap Players above to compare them"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STATS CONTENT: Scrolls independently -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/compareStatsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Radar Chart Visualization -->
            <RelativeLayout
                android:id="@+id/layoutRadarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/radarChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />

                <!-- Custom Legend -->
                <LinearLayout
                    android:id="@+id/layoutRadarLegend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="@drawable/rounded_stat_bg_light"
                    android:elevation="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <View
                            android:id="@+id/viewLegendColor1"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_bg_grey"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:id="@+id/tvLegendName1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Player 1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:id="@+id/viewLegendColor2"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_bg_grey"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:id="@+id/tvLegendName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Player 2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- Overall Category Container -->
            <LinearLayout
                android:id="@+id/layoutOverallContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/containerMatches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/containerBatting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/containerBowling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/containerFielding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- H2H Category Container -->
            <LinearLayout
                android:id="@+id/layoutH2HContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/h2h_header_1"
                    layout="@layout/include_h2h_header" />

                <LinearLayout
                    android:id="@+id/containerH2H_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp" />

                <include
                    android:id="@+id/h2h_header_2"
                    layout="@layout/include_h2h_header" />

                <LinearLayout
                    android:id="@+id/containerH2H_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
