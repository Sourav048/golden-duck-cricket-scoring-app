<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:padding="20dp">

    <!-- Trading Card Outer Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_player_trading_card"
        android:padding="24dp">

        <!-- Top Header Branding -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏏"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRICKET TRADING CARD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:letterSpacing="0.12"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCardLeagueName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GULLY PREMIER LEAGUE"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#80DEEA"
                android:background="@drawable/bg_jersey_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.08"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Player Hero Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Photo Frame with Glowing Ring -->
            <FrameLayout
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTradingPhotoFrame"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="70dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#141E33"
                    app:strokeWidth="3.5dp"
                    app:strokeColor="#FFD700"
                    app:contentPadding="0dp">

                    <ImageView
                        android:id="@+id/ivCardPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person_placeholder"
                        android:contentDescription="Player Photo" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Jersey Badge -->
            <TextView
                android:id="@+id/tvCardJersey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#48"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:background="@drawable/bg_jersey_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp"
                android:letterSpacing="0.05"
                android:layout_marginTop="10dp" />

            <!-- Player Name -->
            <TextView
                android:id="@+id/tvCardPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sourav Sharma"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:shadowDy="2"
                android:layout_marginTop="8dp" />

            <!-- Team / Role Subtitle -->
            <TextView
                android:id="@+id/tvCardTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sushant Scorchers • Career Profile"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:letterSpacing="0.04"
                android:layout_marginTop="4dp" />

            <!-- Accolade Chips Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tvCardRankOverall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ Rank #1 Overall"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:background="@drawable/bg_jersey_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3.5dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvCardPotmAwards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 8 Awards"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#80DEEA"
                    android:background="@drawable/bg_jersey_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3.5dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20FFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- ── BATTING SIGNATURE ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_stat_box"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏏 BATTING SIGNATURE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#80DEEA"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RUNS"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBatRuns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="603"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVERAGE"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBatAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#80DEEA" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STRIKE RATE"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBatSR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="172.8"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#81C784" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGHEST"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBatHighest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="84*"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFD54F" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── BOWLING WEAPON ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_stat_box"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ BOWLING WEAPON"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#CE93D8"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WICKETS"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBowlWkts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ECONOMY"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBowlEco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6.6"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#81C784" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVERAGE"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBowlAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.4"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#CE93D8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BEST (BBI)"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardBowlBBI"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3/1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFD54F" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── IMPACT & TALISMAN ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_stat_box"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 IMPACT &amp; TALISMAN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFD54F"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MATCHES"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardTotalMatches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="41"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEAM WIN %"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardTeamWinPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="39.0%"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#81C784" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POTM"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardPotmCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFD700" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISMISSALS"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvCardFielding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#80DEEA" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Card Footer -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORING APP"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cricket Scoring &amp; Player Analytics"
                    android:textSize="9.5sp"
                    android:textColor="#64748B" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFICIAL CARD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:background="@drawable/bg_jersey_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:letterSpacing="0.1"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
