<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Fixed Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnProceedTop"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMatchConfigTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Match Setup"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Venue, teams &amp; rules"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProceedTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Proceed"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="textEnd"
                    app:iconSize="22dp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Venue Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Match Venue"
                            app:startIconDrawable="@drawable/ic_venue_location"
                            app:startIconTint="?attr/colorPrimary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <AutoCompleteTextView
                                android:id="@+id/venueInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Match Venue"
                                android:inputType="textCapWords"
                                android:completionThreshold="1"
                                android:padding="16dp"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:importantForAutofill="no" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Teams Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Red Team (Default)"
                            app:startIconDrawable="@drawable/ic_edit_team"
                            app:startIconTint="?attr/colorPrimary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/teamAInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:importantForAutofill="no" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- VS Badge Divider -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginVertical="10dp">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="?attr/colorOutline"
                                android:alpha="0.3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="custom_color"
                                android:text="VS"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimary"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:gravity="center"
                                android:background="@drawable/bg_vs_badge"
                                app:backgroundTint="?attr/colorPrimary"
                                android:layout_marginHorizontal="12dp"
                                android:includeFontPadding="false" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="?attr/colorOutline"
                                android:alpha="0.3" />

                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Blue Team (Default)"
                            app:startIconDrawable="@drawable/ic_edit_team"
                            app:startIconTint="?attr/colorSecondary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/teamBInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:importantForAutofill="no" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Match Format Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Number of Overs"
                            app:startIconDrawable="@drawable/ic_overs"
                            app:startIconTint="?attr/colorPrimary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/oversInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="16dp"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:importantForAutofill="no" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ballTypeInputLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Select Ball Type"
                            app:startIconDrawable="@drawable/ic_ball_type"
                            app:startIconTint="?attr/colorPrimary"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_chevron_right"
                            app:endIconTint="?attr/colorPrimary"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/ballTypeSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select Ball Type"
                                android:inputType="none"
                                android:focusable="false"
                                android:clickable="true"
                                android:padding="16dp"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:cursorVisible="false"
                                android:background="@null"
                                android:importantForAutofill="no" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rule Toggles Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRunsOnWide"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Runs on Wides/No-Balls"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingVertical="10dp"
                            android:checked="false" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.15" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFreeHit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Free Hit after No Ball"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingVertical="10dp"
                            android:checked="true" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.15" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRunsOnBye"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Runs on Byes/Leg-Byes"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingVertical="10dp"
                            android:checked="false" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.15" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchOverthrow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Runs on Overthrow"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingVertical="10dp"
                            android:checked="false" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.15" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchEveryPlayerBats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Last Man Stand"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:paddingVertical="10dp"
                            android:checked="true" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
