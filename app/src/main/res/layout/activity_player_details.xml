<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic Themed Header -->
            <RelativeLayout
                android:id="@+id/layoutPlayerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorPrimary"
                android:paddingTop="32dp"
                android:paddingBottom="56dp"
                android:paddingHorizontal="24dp">

                <ImageButton
                    android:id="@+id/btnBackProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#FFFFFF"
                    android:layout_alignParentStart="true"
                    android:contentDescription="Back" />

                <ImageButton
                    android:id="@+id/btnPlayerDetailsMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="#FFFFFF"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="Options" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPhotoFrame"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        app:cardCornerRadius="45dp"
                        app:cardElevation="10dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="4dp"
                        app:strokeColor="#FFFFFF"
                        app:contentPadding="0dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivDetailPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:transitionName="player_image_transition"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDetailNameDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Player Name"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="20dp" />

                    <TextView
                        android:id="@+id/tvDetailJerseyDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvDetailSubTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCAL PROFILE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#20FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <!-- Ranking Chips Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#25FFFFFF">
                            <TextView android:id="@+id/tvRankOverall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="8dp" android:paddingHorizontal="16dp" android:tag="custom_color" android:text="Overall Ranking:- #-" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#25FFFFFF">
                            <TextView android:id="@+id/tvRankBatting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="8dp" android:paddingHorizontal="16dp" android:tag="custom_color" android:text="Batting Ranking:- #-" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#25FFFFFF">
                            <TextView android:id="@+id/tvRankBowling" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="8dp" android:paddingHorizontal="16dp" android:tag="custom_color" android:text="Bowling Ranking:- #-" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- Statistics Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="-28dp"
                android:background="@drawable/rounded_corner_overlay">

                <!-- Batting Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏏 BATTING CAREER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:alpha="0.8"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="true">
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatMatches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatInnings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatRuns" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatHighest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatAvg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatSR" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatFours" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatSixes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatNotOut" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBatDucks" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBat30s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBat50s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBat80s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBat100s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                </GridLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutline" android:layout_marginVertical="24dp" android:alpha="0.2" />

                <!-- Bowling Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🥎 BOWLING CAREER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:alpha="0.8"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="true">
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlMatches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlInnings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlWickets" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlAvg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlEco" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlBBI" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlMaidens" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlHattricks" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowl2w" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowl3w" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowl5w" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxBowlSixesConceded" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                </GridLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutline" android:layout_marginVertical="24dp" android:alpha="0.2" />

                <!-- Fielding Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧤 FIELDING CAREER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:alpha="0.8"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="true"
                    android:layout_marginBottom="40dp">
                    <include layout="@layout/item_stat_box" android:id="@+id/boxFieldMatches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxFieldCatches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxFieldStumpings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <include layout="@layout/item_stat_box" android:id="@+id/boxFieldRunOuts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                </GridLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
