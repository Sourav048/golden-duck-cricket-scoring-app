<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Scoring" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary (Teal) -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/surface_card</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimary</item>

        <!-- Secondary (Slate) -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorOnAccent</item>
        <item name="colorSecondaryContainer">@color/surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/colorAccent</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider_main</item>

        <!-- Custom Highlights Mapping -->
        <item name="runHighlight">@color/run_highlight</item>
        <item name="wicketHighlight">@color/wicket_highlight</item>
        <item name="boundaryHighlight">@color/boundary_highlight</item>
        <item name="extraHighlight">@color/extra_slate</item>
        <item name="dotBallHighlight">@color/dot_ball_grey</item>

        <!-- Prestige Mapping -->
        <item name="prestigeGold">@color/accent_amber</item>
        <item name="prestigeOrange">@color/prestige_orange</item>
        <item name="prestigePurple">@color/accent_purple</item>

        <item name="cardViewStyle">@style/Widget.Material3.CardView.Elevated</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="Theme.Scoring" parent="Base.Theme.Scoring" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_main</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Scoring</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
    </style>
</resources>
