<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- CRITICAL: Internet permission for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera hardware requirement (optional, but good practice) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Camera permission for taking a player photo in-app -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permission to trigger APK installation from inside the app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ScoringApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scoring">

        <!-- OneSignal Background Notification Service Extension -->
        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="com.example.scoring.AppNotificationServiceExtension" />

        <!-- HOME — launches when the app icon is tapped -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Handle .cricket files: High Priority Handler for WhatsApp -->
            <intent-filter android:label="Golden Duck" android:priority="1000">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/binary" />
                <data android:mimeType="application/x-cricket" />
            </intent-filter>

            <!-- Handle .cricket files: Extension Match (for File Managers) -->
            <intent-filter android:label="Golden Duck" android:priority="999">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.cricket" />
                <data android:pathSuffix=".cricket" />
            </intent-filter>
        </activity>

        <!-- SETUP — match configuration screen -->
        <activity android:name=".SetupActivity" android:exported="false" />


        <!-- PLAYER LIST — view and manage player roster -->
        <activity android:name=".PlayerListActivity" android:exported="false" />
        <activity android:name=".GlobalSearchActivity" android:exported="false" />

        <!-- TOSS — handle match toss and decision -->
        <activity android:name=".TossActivity" android:exported="false" />

        <!-- PLAYER DETAILS — detailed career statistics -->
        <activity android:name=".PlayerDetailsActivity" android:exported="false" />
        <activity android:name=".PlayerCompareActivity" android:exported="false" />

        <!-- MATCH HISTORY — view previous match results -->
        <activity android:name=".MatchHistoryActivity" android:exported="false" />

        <!-- STATS — batting and bowling leaderboards -->
        <activity android:name=".StatsActivity" android:exported="false" />
        <activity android:name=".LeaderboardActivity" android:exported="false" />

        <!-- PLAYER ENTRY — add players to teams -->
        <activity android:name=".PlayerEntryActivity" android:exported="false" />

        <!-- SCORING — live ball-by-ball scoring -->
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- MATCH DETAILS — historical match view -->
        <activity android:name=".MatchDetailsActivity" android:exported="false" />

        <activity android:name=".GullyManagementActivity" android:exported="false" />
        <activity
            android:name=".LeagueChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".NotificationReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".NotificationDismissReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
